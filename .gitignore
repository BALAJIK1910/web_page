# ============================================================
# .gitignore — Root configuration for ShopEase
# ============================================================

# Secrets & Environment variables
.env
.env.*
*.env
!.env.example

# Maven & Build artifacts
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/timing.properties
.flattened-pom.xml

# IDEs & Code Editors
.vscode/
.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
*.sublime-workspace
*.sublime-project

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs & Runtime
*.log
logs/
**/logs/
*.tmp
*.temp
*.swp
*~

# Frontend / Node (if local tooling is used)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

